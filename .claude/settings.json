{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git push -u origin *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr ready *)",
      "Bash(python -m unittest *)",
      "Bash(python -m cut_planner *)",
      "Bash(python .claude/skills/ui-ux-pro-max/scripts/search.py *)",
      "Bash(python .claude/hooks/role_gate.py --self-test)"
    ],
    "ask": [
      "Edit(/.github/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/agency-agents/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/LOOP.md)",
      "Edit(/loop-constraints.md)",
      "Edit(/loop-budget.md)",
      "Edit(**/.claude/agents/**)",
      "Edit(**/.claude/skills/**)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/agency-agents/**)",
      "Write(**/.claude/agents/**)",
      "Write(**/.claude/skills/**)",
      "Write(**/.claude/hooks/**)",
      "Write(**/.claude/settings.json)",
      "Write(**/.claude/agency-agents/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh release create *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push origin main *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/role_gate.py",
              "check"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/role_gate.py",
              "record"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
